# ==============================================================================
# Environment Configuration & Secrets
# ==============================================================================

# 1. TypeSafe AI Jev API (Optional - Leave empty to use built-in SIMULATED engine)
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/decide
DEFAULT_ENGINE_MODE=SIMULATED

# 2. Administrative Security Key (Protects global workspace wipe & reset endpoints)
SANDBOX_ADMIN_KEY=sor-admin-secret-2026

# 3. Twilio WhatsApp Sandbox (Optional - Needed for live WhatsApp phone testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# 4. Gating Thresholds (Defaults)
MIN_TRADE_CONFIDENCE=0.70
MIN_SOR_CONFIDENCE=0.65
MIN_PROBABILITY_MARGIN=0.15
DAMP_HAZARD_THRESHOLD=0.40
INAPPROPRIATE_CONTENT_THRESHOLD=0.50

# 5. Session Isolation TTL (48 hours in seconds)
SESSION_TTL_SECONDS=172800

# 6. Service URLs (Used by Streamlit when connecting to remote/local backend)
SANDBOX_API_BASE=http://127.0.0.1:8000/api/v1
SANDBOX_MCP_URL=http://127.0.0.1:8000/mcp/sse
SANDBOX_DOCS_URL=http://127.0.0.1:8000/docs
